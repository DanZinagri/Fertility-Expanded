<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FertilityExpanded</RootNamespace>
    <AssemblyName>FertilityExpanded</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Fertility Expanded</AssemblyTitle>
    <Company>Lucius</Company>
    <Product>Fertility Expanded</Product>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <Import Project="Local.Build.props" Condition="Exists('Local.Build.props')" />

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManagedDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldManagedDir)' == ''" Text="RimWorldManagedDir is not configured. Copy Local.Build.props.example to Local.Build.props and set the local path, or pass the property to MSBuild." />
    <Error Condition="'$(HarmonyAssemblyPath)' == ''" Text="HarmonyAssemblyPath is not configured. Copy Local.Build.props.example to Local.Build.props and set the local path, or pass the property to MSBuild." />
    <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found under RimWorldManagedDir." />
    <Error Condition="'$(RimWorldManagedDir)' != '' and !Exists('$(RimWorldManagedDir)\UnityStubs.dll')" Text="UnityStubs.dll was not found under RimWorldManagedDir. Use the RimWorld 1.7 installation directory." />
    <Error Condition="'$(HarmonyAssemblyPath)' != '' and !Exists('$(HarmonyAssemblyPath)')" Text="0Harmony.dll was not found at HarmonyAssemblyPath." />
  </Target>

  <Target Name="UpdateModAssembly" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'" Text="UpdateModAssembly requires Configuration=Release." />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\..\..\Assemblies\$(TargetFileName)" />
  </Target>
</Project>
