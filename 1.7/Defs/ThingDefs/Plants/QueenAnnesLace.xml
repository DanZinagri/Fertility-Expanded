<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="RoughPlantBase">
    <defName>FE_QueenAnnesLaceParts</defName>
    <label>bunch of Queen Anne's lace</label>
    <description>Dried flowers and seeds from Queen Anne's lace.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <texPath>Things/Item/Resource/PlantFoodRaw/FE_QueenAnnesLaceParts</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.60</drawSize>
      <color>(0.92,0.88,0.78)</color>
    </graphicData>
    <statBases>
      <MarketValue>1.4</MarketValue>
      <Flammability>1.3</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>PlantMatter</li>
    </thingCategories>
    <ingestible>
      <preferability>DesperateOnly</preferability>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>FE_Plant_QueenAnnesLace</defName>
    <label>Queen Anne's lace</label>
    <description>A delicate medicinal herb with pale flowers. It has been used in medicine across the rim among tribals and industrialists alike.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/FE_QueenAnnesLace</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <color>(0.92,0.88,0.78)</color>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <immatureGraphicPath>Things/Plant/Healroot_Immature</immatureGraphicPath>
      <fertilityMin>0.1</fertilityMin>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <growDays>6.0</growDays>
      <maxOptimalGrowthTemperature>30</maxOptimalGrowthTemperature>
      <maxGrowthTemperature>42</maxGrowthTemperature>
      <growOptimalGlow>0.8</growOptimalGlow>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>FE_QueenAnnesLaceParts</harvestedThingDef>
      <drugForHarvestPurposes>true</drugForHarvestPurposes>
      <harvestYield>6</harvestYield>
      <sowMinSkill>5</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>0.4~1.0</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Health</purpose>
    </plant>
  </ThingDef>

</Defs>
